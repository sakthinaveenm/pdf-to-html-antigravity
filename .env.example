# Multilingual PDF to HTML Platform Environment Variables

# Application
APP_NAME="Multilingual PDF to HTML Converter"
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Concurrency & Memory Budget
# Hardware Profile: AMD Ryzen 7 4800H / Apple Silicon, 16GB RAM, RTX 3050 Ti 4GB VRAM
MAX_CONCURRENT_WORKERS=1
DEFAULT_CONVERTER=AUTO
MAX_MEMORY_PER_WORKER_MB=4096

# Upload Constraints
MAX_UPLOAD_SIZE_BYTES=157286400
MAX_PDF_PAGES=1000

# OCR Configurations
DEFAULT_OCR_LANGUAGES=eng+tam+hin
TESSERACT_CMD=/opt/homebrew/bin/tesseract
TESSDATA_PREFIX=/opt/homebrew/share/tessdata

# Device Mode: cpu, cuda, mps, auto
DEVICE_MODE=cpu

